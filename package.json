{
  "name": "edentext",
  "version": "0.14.0",
  "type": "module",
  "description": "A fully client-side, serverless rich-text editor that saves documents as .odt",
  "license": "AGPL-3.0-only",
  "author": "Steffen Becker <stffn.becker@gmail.com>",
  "homepage": "https://stffnb.github.io/edentext/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stffnb/edentext.git"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lo": "vitest run tests/lo-roundtrip.test.ts tests/lo-fuzz.test.ts tests/lo-render-consistency.test.ts tests/lo-password.test.ts tests/lo-revisions.test.ts",
    "test:smoke": "node tests/smoke/run.mjs",
    "test:dom": "node tests/dom/run.mjs",
    "test:layout": "node tests/layout/run.mjs",
    "test:monkey": "node tests/monkey/run.mjs",
    "test:tabs": "node tests/tabs/run.mjs",
    "test:coverage": "vitest run --coverage",
    "test:parity": "node tests/render-parity/run.mjs",
    "test:parity:fixtures": "node tests/render-parity/make-fixtures.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@vitest/coverage-v8": "^5.1.0",
    "dictionary-de": "^3.0.0",
    "dictionary-el": "^4.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-it": "^2.0.0",
    "dictionary-pt-pt": "^2.0.0",
    "dictionary-ru": "^3.0.0",
    "dictionary-uk": "^4.0.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-bold": "^3.33.0",
    "@tiptap/extension-bullet-list": "^3.33.0",
    "@tiptap/extension-document": "^3.33.0",
    "@tiptap/extension-font-family": "^3.33.0",
    "@tiptap/extension-hard-break": "^3.33.0",
    "@tiptap/extension-heading": "^3.33.0",
    "@tiptap/extension-highlight": "3.33.0",
    "@tiptap/extension-history": "^3.33.0",
    "@tiptap/extension-italic": "^3.33.0",
    "@tiptap/extension-link": "3.33.0",
    "@tiptap/extension-list-item": "^3.33.0",
    "@tiptap/extension-ordered-list": "^3.33.0",
    "@tiptap/extension-paragraph": "^3.33.0",
    "@tiptap/extension-strike": "^3.33.0",
    "@tiptap/extension-subscript": "^3.33.0",
    "@tiptap/extension-superscript": "^3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-text": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "docx": "^9.15.3",
    "franc-min": "^6.2.0",
    "harper.js": "^2.10.0",
    "html2canvas": "^1.4.1",
    "hunspell-asm": "^4.0.2",
    "jspdf": "^4.2.1",
    "odf-kit": "^0.14.5",
    "utif2": "^4.1.0"
  },
  "overrides": {
    "prosemirror-transform": "1.12.2"
  }
}
